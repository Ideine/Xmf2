<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
	<TargetFramework>net10.0-android</TargetFramework>
	<LangVersion>9</LangVersion>
	<Nullable>disable</Nullable>
	<ImplicitUsings>disable</ImplicitUsings>
	<RootNamespace>Xmf2.Droid.Rx</RootNamespace>
	<SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
	<IsPackable>false</IsPackable>
	<UseMauiEssentials>true</UseMauiEssentials>
</PropertyGroup>
<ItemGroup>
	<Compile Remove="Properties/AssemblyInfo.cs"/>
</ItemGroup>
<ItemGroup>
	<!-- Direct pins override ReactiveUI.AndroidX's older LiveData (2.8.4.1) so it aligns with net10 MAUI Essentials' AndroidX 2.9.2.1 line. -->
	<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.9.2.1" />
	<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.9.2.1" />
	<PackageReference Include="ReactiveUI.AndroidX" Version="20.1.63" />
</ItemGroup>
<ItemGroup>
  <Folder Include="ViewHandlers\" />
  <Folder Include="Views\" />
</ItemGroup>
<ItemGroup>
  <ProjectReference Include="..\Xmf2.Commons.Rx\Xmf2.Commons.Rx.csproj" />
</ItemGroup>
</Project>